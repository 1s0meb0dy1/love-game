{
  "name": "love-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/compress.mjs",
    "preview": "vite preview",
    "test": "node tests/run-all.js",
    "test:unit": "node tests/run-all.js --unit",
    "test:ui": "node tests/run-all.js --ui",
    "size": "node scripts/check-size.mjs",
    "verify": "npm test && npm run build && npm run size",
    "rules:render": "node scripts/render-rules.mjs",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --config firebase/emulator.json --project demo-love-game --only database \"node tests/firebase-rules.test.cjs\"",
    "bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "qrcode-generator": "1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "firebase": "^13.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.1.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
