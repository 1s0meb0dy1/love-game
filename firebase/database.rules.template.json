{
  "rules": {
    ".read": false,
    ".write": false,
    "questions": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'OWNER_UID'",
      "$qid": {
        ".validate": "$qid === '_meta' || (newData.hasChildren(['id','categoryId','level','text']) && newData.child('id').isString() && newData.child('categoryId').isString() && newData.child('level').isString() && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length < 600)",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "categoryId": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "level": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 599"
        },
        "targetId": {
          ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^aud_[a-f0-9]{64}$/))"
        },
        "num": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "hidden": {
          ".validate": "newData.isBoolean()"
        },
        "hiddenAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999999999"
        },
        "archived": {
          ".validate": "newData.isBoolean()"
        },
        "schema": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "sessions": {
      "$sid": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.child('deleted').exists() || (newData.child('deleted').val() === true && newData.child('payload').val() === ''))",
        ".validate": "newData.hasChildren(['payload','updatedAt']) && (!newData.child('deleted').exists() || (newData.child('deleted').val() === true && newData.child('payload').val() === ''))",
        "payload": {
          ".validate": "newData.isString() && newData.val().length <= 59999"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999999999"
        },
        "deleted": {
          ".validate": "newData.val() === true"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "live": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.child('deleted').exists() || (newData.child('deleted').val() === true && newData.child('status').val() === 'ended'))",
        ".validate": "newData.hasChildren(['ver','by','t']) && (!newData.child('deleted').exists() || (newData.child('deleted').val() === true && newData.child('status').val() === 'ended' && !newData.child('gid').exists() && !newData.child('g').exists() && !newData.child('solo').exists() && !newData.child('n').exists() && !newData.child('dk').exists() && !newData.child('ids').exists() && !newData.child('d').exists() && !newData.child('idx').exists() && !newData.child('max').exists() && !newData.child('hist').exists() && !newData.child('hard').exists() && !newData.child('pl').exists() && !newData.child('fx').exists() && !newData.child('spin').exists() && !newData.child('pun').exists() && !newData.child('p').exists() && !newData.child('st').exists()))",
        "ver": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999999999"
