              },
              "answered": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
              },
              "skipped": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
              },
              "durationSec": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 31536000"
              },
              "avgAnswerSec": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 31536000"
              },
              "timerSec": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600"
              },
              "punishCount": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
              },
              "mode": {
                ".validate": "newData.isString() && newData.val().length <= 16"
              },
              "punishOn": {
                ".validate": "newData.isBoolean()"
              },
              "complete": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              },
              "partial": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              },
              "byCat": {
                "$id": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
                }
              },
              "byLevel": {
                "$id": {
