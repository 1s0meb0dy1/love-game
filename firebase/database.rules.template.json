          ".validate": "(newData.hasChildren(['updatedAt','ownerUid','sessionRef']) && !newData.child('deleted').exists()) || (newData.hasChildren(['updatedAt','ownerUid','deleted']) && newData.child('deleted').val() === true && !newData.child('games').exists() && !newData.child('createdAt').exists())",
