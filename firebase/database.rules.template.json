          ".validate": "(newData.hasChildren(['updatedAt','ownerUid','sessionRef']) && !newData.child('deleted').exists() && newData.hasChildren(['sid','names']) && newData.child('names').hasChildren()) || (newData.hasChildren(['updatedAt','ownerUid','deleted']) && newData.child('deleted').val() === true && !newData.child('games').exists() && !newData.child('createdAt').exists() && newData.child('names').val() === '' && newData.child('sid').val() === '')",
          "ownerUid": {
            ".validate": "newData.isString() && (auth.uid === 'OWNER_UID' || newData.val() === auth.uid)"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999999999"
          },
