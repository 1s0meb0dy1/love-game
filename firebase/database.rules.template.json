          "text": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "icon": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "key": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "$other": {
            ".validate": false
          }
        },
        "st": {
          ".validate": "newData.isString() && newData.val().length <= 20000"
        },
        "p": {
          "$device": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999999999"
          }
        },
        "deleted": {
          ".validate": "newData.val() === true"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "analytics": {
      ".read": "auth != null && auth.uid === 'OWNER_UID'",
