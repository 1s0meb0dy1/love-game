                "$i": {
                  ".validate": "$i.matches(/^([0-9]|[1-9][0-9]|[1-3][0-9][0-9])$/) && (newData.isString() && newData.val().length <= 160)"
                }
              },
              "skippedIds": {
                "$i": {
                  ".validate": "$i.matches(/^([0-9]|[1-9][0-9]|[1-3][0-9][0-9])$/) && (newData.isString() && newData.val().length <= 160)"
                }
