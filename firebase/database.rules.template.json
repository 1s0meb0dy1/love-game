                  "name": {
                    ".validate": "newData.isString() && newData.val().length <= 25"
                  },
                  "answered": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
                  },
                  "skipped": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          },
          "deleted": {
            ".validate": "newData.val() === true"
          },
          "sessionRef": {
            ".validate": "newData.isString() && newData.val().matches(/^s_[a-f0-9]{64}$/)"
          }
        }
      },
