        "pl": {
          ".validate": "newData.isString() && newData.val().length <= 4000"
        },
        "fx": {
          ".validate": "newData.hasChildren(['timerOn','timerSec','punishOn'])",
          "timerOn": {
            ".validate": "newData.isBoolean()"
          },
          "timerSec": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600"
          },
          "punishOn": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "spin": {
          ".validate": "newData.hasChildren(['id','idx','winner','cands'])",
